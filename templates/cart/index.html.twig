{% extends 'base.html.twig' %}

{% block title %}Mon Panier - JulieCreations{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">Mon Panier</h1>

    {% if items is empty %}
        <div class="alert alert-info">
            Votre panier est vide.
            <a href="{{ path('app_product_index') }}" class="alert-link">Continuer mes achats</a>
        </div>
    {% else %}
        <table class="table">
            <thead>
                <tr>
                    <th>Produit</th>
                    <th>Prix unitaire</th>
                    <th>Quantité</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
    <td>
        {{ item.product.title }}
        {% if item.instructions %}
            <br>
            <small class="text-muted">
                <i class="fas fa-pen"></i> {{ item.instructions }}
            </small>
        {% endif %}
    </td>
    <td>{{ item.product.price }} €</td>
    <td>{{ item.quantity }}</td>
    <td>{{ (item.product.price * item.quantity)|number_format(2) }} €</td>
    <td>
        <a href="{{ path('app_cart_remove', {'id': item.product.id}) }}" 
           class="btn btn-sm btn-danger">
            <i class="fas fa-trash"></i>
        </a>
    </td>
</tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total :</th>
                    <th>{{ total|number_format(2) }} €</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>

        <div class="d-flex justify-content-between mt-4">
            <a href="{{ path('app_product_index') }}" class="btn btn-secondary">
                Continuer mes achats
            </a>
           <a href="{{ path('app_order_validate') }}" class="btn btn-success">
    Valider ma commande
</a>
        </div>
    {% endif %}
</div>
{% endblock %}

{% extends 'base.html.twig' %}
{% block title %}{{ product.title }} - JulieCreations{% endblock %}
{% block body %}
<div class="container mt-5">
    <a href="{{ path('app_product_index') }}" class="btn btn-outline-secondary mb-4">
        <i class="fas fa-arrow-left"></i> Retour à la boutique
    </a>
    <div class="row bg-white p-4 shadow-sm rounded">
        {# Colonne Image #}
        <div class="col-md-6 text-center">
            {% if product.imageName %}
                <img src="{{ asset('uploads/products/' ~ product.imageName) }}" 
                     alt="{{ product.title }}" 
                     class="img-fluid rounded shadow" style="max-height: 400px;">
            {% else %}
                <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 300px; color: #ccc;">
                    <i class="fas fa-image fa-4x"></i>
                </div>
            {% endif %}
        </div>
        {# Colonne Infos #}
        <div class="col-md-6">
            <h1 class="fw-bold">{{ product.title }}</h1>
            <span class="badge bg-light text-dark mb-3 border">{{ product.category }}</span>
            
            <h3 class="text-primary mb-4">{{ product.price }} €</h3>
            
            <div class="mb-4">
                <h5>Description</h5>
                <p class="text-muted">{{ product.description }}</p>
            </div>
            <p>
                <strong>Personnalisable :</strong> 
                {{ product.isPersonalizable ? '✅ Oui' : '❌ Non' }}
            </p>

            <form action="{{ path('app_cart_add', {'id': product.id}) }}" method="POST">
                {% if product.isPersonalizable %}
                    <div class="mb-3">
                        <label for="instructions" class="form-label fw-bold">
                            <i class="fas fa-pen"></i> Instructions de personnalisation
                        </label>
                        <textarea 
                            name="instructions" 
                            id="instructions" 
                            class="form-control" 
                            rows="4" 
                            placeholder="{% if product.category == 'bouquet-satin' %}Ex: Couleur des roses (rouge, rose, blanc...), nombre de roses, message sur le ruban...{% elseif product.category == 'deco' and 'cadre' in product.title|lower %}Ex: Texte à inscrire sur le cadre, couleur du texte, couleur des fleurs...{% elseif product.category == 'deco' and 'tableau' in product.title|lower %}Ex: Couleur du texte, police d'écriture (moderne, élégante, manuscrite...), couleurs dominantes...{% else %}Décrivez vos souhaits de personnalisation ici...{% endif %}"></textarea>
                        <small class="text-muted">
                            {% if product.category == 'bouquet-satin' %}
                                💐 Précisez la couleur, le nombre de roses et votre message.
                            {% elseif product.category == 'deco' %}
                                🖼️ Indiquez vos choix de couleurs, texte et style.
                            {% else %}
                                ✨ Décrivez vos préférences de personnalisation.
                            {% endif %}
                        </small>
                    </div>
                {% endif %}

                <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">
                    <i class="fas fa-shopping-cart"></i> Ajouter au panier
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}

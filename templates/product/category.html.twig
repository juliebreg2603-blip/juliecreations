{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 style="color: #bfa14d; font-weight: bold;">{{ title }}</h1>
        <hr style="width: 50px; border: 2px solid #bfa14d; margin: auto;">
    </div>

    <div class="row g-4"> 
        {% for product in products %}
            <div class="col-12 col-sm-6 col-md-4"> 
                <div class="card h-100 shadow-sm" style="border-radius: 15px; border: none; overflow: hidden;">
                    
                    <div style="height: 250px; background-color: #fcfcfc; display: flex; align-items: center; justify-content: center; padding: 10px;">
                        {% if product.image %}
                            <img src="{{ asset('uploads/products/' ~ product.image) }}" 
                                 style="max-width: 100%; max-height: 100%; object-fit: contain;" 
                                 alt="{{ product.title }}">
                        {% else %}
                            <span class="text-muted">📷</span>
                        {% endif %}
                    </div>

                    <div class="card-body">
                        <h5 style="font-size: 1.1rem; font-weight: bold; color: #4a4a4a;">{{ product.title }}</h5>
                        <p class="text-muted" style="font-size: 0.85rem; height: 40px; overflow: hidden;">{{ product.description }}</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span style="color: #bfa14d; font-weight: bold; font-size: 1.3rem;">{{ product.price }} €</span>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <p>🌸 Pas encore d'articles ici.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}JulieCreations{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
        <style>
            .navbar-brand { font-weight: bold; color: #bca47a !important; font-size: 1.5rem; }
            .nav-link { color: #555 !important; font-weight: 500; }
            .nav-link:hover { color: #bca47a !important; }
            .cart-badge { position: absolute; top: -5px; right: -10px; font-size: 0.7rem; }
            body { background-color: #f8f9fa; }
        </style>
    </head>
    <body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_product_index') }}">JulieCreations</a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_product_index') }}">Boutique</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_product_bijoux') }}">Bijoux</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_product_bouquet_satin') }}">Bouquets & Satin</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_product_deco') }}">Déco</a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item me-4">
                        <a class="nav-link position-relative" href="{{ path('app_cart_index') }}">
                            <i class="fas fa-shopping-basket fa-lg"></i>
                            <span class="badge rounded-pill bg-danger cart-badge">
                                {{ app.session.get('cart')|length|default(0) }}
                            </span>
                        </a>
                    </li>
                   {% if app.user %}
    <li class="nav-item">
        <a class="nav-link" href="{{ path('app_profile') }}">
            <i class="fas fa-user me-1"></i>Mon Profil
        </a>
    </li>
    {% if is_granted('ROLE_ADMIN') %}
        <li class="nav-item">
            <a class="nav-link text-success" href="{{ path('app_product_new') }}">
                <i class="fas fa-plus-circle me-1"></i>Ajouter un produit
            </a>
        </li>
    {% endif %}
    <li class="nav-item">
        <a class="nav-link text-danger" href="{{ path('app_logout') }}">Déconnexion</a>
    </li>
    {% else %}
    <li class="nav-item">
        <a class="nav-link" href="{{ path('app_login') }}">Connexion</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="{{ path('app_register') }}">Inscription</a>
    </li>
{% endif %}
                </ul>
            </div>
        </div>
    </nav>
    <div class="container mt-4">
        {% block body %}{% endblock %}
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>
